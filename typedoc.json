{
  "entryPoints": ["src/components/**/*.tsx", "src/components/**/*.ts"],
  "entryPointStrategy": "expand",
  "out": "docs",
  "name": "ByteToolbox Documentation",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "readme": "COMPONENT-DOCUMENTATION.md",
  "theme": "default",
  "categorizeByGroup": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Tool Components",
    "Infrastructure Components", 
    "Theme Components",
    "UI Components",
    "Testing Components",
    "Other"
  ],
  "sort": ["source-order"],
  "kindSortOrder": [
    "Project",
    "Module", 
    "Namespace",
    "Enum",
    "Class",
    "Interface",
    "Constructor",
    "Property",
    "Variable",
    "Function",
    "Accessor",
    "Method"
  ],
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "searchInComments": true,
  "cleanOutputDir": true,
  "exclude": [
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/node_modules/**"
  ]
}